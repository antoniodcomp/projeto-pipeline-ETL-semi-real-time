# Configurações Gerais da Aplicação
APP_NAME="UCI Dataset Replayer"

# Caminho do arquivo de dados (relativo ao diretório de execução/container)
FILE_PATH="/data/household_power_consumption.txt"

# Configurações padrões do simulador/replayer
DEFAULT_HOUSE_ID="house_001"
DEFAULT_RATE=1.0

API_HOST="0.0.0.0"
API_PORT=8000

KAFKA_BOOTSTRAP_SERVERS="kafka:9092"
KAFKA_TOPIC="energy_consumption_events"